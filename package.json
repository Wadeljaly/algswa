{
    "name": "al-qaswaa-pos",
    "version": "1.0.2",
    "description": "نظام إدارة المبيعات - القصواء",
    "main": "electron-main.js",
    "author": "MOHAMED AL-JALI",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --inspect",
        "build": "electron-builder --win --x64",
        "build:portable": "electron-builder --win portable"
    },
    "build": {
        "appId": "com.alqaswaa.pos",
        "productName": "القصواء - نظام المبيعات",
        "copyright": "© 2026 WAD AL-JALI",
        "directories": {
            "output": "dist"
        },
        "icon": "assets/icon.png",
        "win": {
            "icon": "assets/icon.png",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "publish": null
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerLanguages": [
                "ar",
                "en"
            ],
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "**/*",
            "!node_modules/.cache/**",
            "!dist/**",
            "!*.log",
            "!test-*.js",
            "!simple-server.js",
            "!jsdom_errors.log",
            "!test-out.txt"
        ]
    },
    "dependencies": {
        "jsdom": "^29.0.1"
    },
    "devDependencies": {
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3"
    }
}